{
  "description": "Goal definition validation vectors (plan §5.5). `valid` is the contract every implementation must agree on; for a valid definition `canonical` is the form the server stores (every key, defaults written out, amounts as decimal strings); for an invalid one `errors` lists the paths the PHP validator names (an SDK only needs to refuse the definition as a whole).",
  "format_version": 1,
  "cases": [
    {
      "name": "the smallest definition, with its defaults written out",
      "definition": {
        "name": "Signup",
        "trigger": {
          "event": "signup"
        }
      },
      "valid": true,
      "canonical": {
        "name": "Signup",
        "trigger": {
          "event": "signup",
          "where": []
        },
        "threshold": {
          "count": 1
        },
        "after": [],
        "within": null,
        "repeat": {
          "mode": "once"
        },
        "value": {
          "type": "none"
        }
      }
    },
    {
      "name": "the plan's example",
      "definition": {
        "name": "Reached level 3",
        "trigger": {
          "event": "level_reached",
          "where": [
            {
              "prop": "level",
              "op": "gte",
              "value": 3
            }
          ]
        },
        "threshold": {
          "count": 1
        },
        "after": [
          12
        ],
        "within": {
          "days": 7,
          "from": "install"
        },
        "repeat": {
          "mode": "once"
        },
        "value": {
          "type": "fixed",
          "amount": 4.0
        }
      },
      "valid": true,
      "canonical": {
        "name": "Reached level 3",
        "trigger": {
          "event": "level_reached",
          "where": [
            {
              "prop": "level",
              "op": "gte",
              "value": 3
            }
          ]
        },
        "threshold": {
          "count": 1
        },
        "after": [
          12
        ],
        "within": {
          "days": 7,
          "from": "install"
        },
        "repeat": {
          "mode": "once"
        },
        "value": {
          "type": "fixed",
          "amount": "4.00"
        }
      }
    },
