{
  "description": "Signed customer ids (plan §4.3, §6.2; documentation/features/visitor-identity.md). 'cases' is what CustomerId::canonical() makes of an id and a type name (null: refused); 'signatures' are cust_sig values under 'linking_key' — HMAC-SHA256(key, canonical), hex — computed independently of the PHP code. 'well_formed' is whether the signature has the shape of one (64 hex characters, either case): an SDK checks the shape and refuses what is not well formed; only the server, which holds the key, can check 'valid'.",
  "format_version": 1,
  "linking_key": "8d2f6a0c4b1e9f7d3a5c2e8b6f0d4a1c9e7b5d3f1a8c6e4b2d0f9a7c5e3b1d8f",
  "cases": [
    {
      "name": "no type means custom, and the id is trimmed",
      "id": "  u-829 ",
      "type": null,
      "expect": "custom:u-829"
    },
    {
      "name": "the type is a vocabulary word: trimmed and folded",
      "id": "u-829",
      "type": " Custom ",
      "expect": "custom:u-829"
    },
    {
      "name": "an email digest folds to lower case",
      "id": "B5FC85E55755F9E0D030A10AB4429B6B2944855F9A0D60077FE832BECBC41D72",
      "type": "email_sha256",
      "expect": "email_sha256:b5fc85e55755f9e0d030a10ab4429b6b2944855f9a0d60077fe832becbc41d72"
    },
    {
      "name": "an md5 email digest",
      "id": "3e3417d7ef77d5932a6734b916515ed5",
      "type": "email_md5",
      "expect": "email_md5:3e3417d7ef77d5932a6734b916515ed5"
    },
    {
      "name": "an md5 digest named as sha256 is refused",
      "id": "3e3417d7ef77d5932a6734b916515ed5",
      "type": "email_sha256",
      "expect": null
    },
    {
      "name": "a digest that is not hex is refused",
      "id": "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz",
      "type": "email_sha256",
      "expect": null
    },
    {
      "name": "an email in the clear is not a digest",
      "id": "ada@example.com",
      "type": "email_md5",
      "expect": null
    },
    {
      "name": "every other type is compared exactly, case included",
      "id": "AbC-9",
      "type": "merchant_id",
      "expect": "merchant_id:AbC-9"
    },
    {
      "name": "an ESP id",
      "id": "sub_123",
      "type": "esp_id",
      "expect": "esp_id:sub_123"
    },
    {
      "name": "a subid",
      "id": "s1",
      "type": "subid",
      "expect": "subid:s1"
    },
    {
      "name": "an unknown type is refused, not treated as custom",
      "id": "u-829",
      "type": "phone",
      "expect": null
    },
    {
      "name": "an empty id is refused",
      "id": "   ",
      "type": null,
      "expect": null
    },
    {
      "name": "a colon inside the id stays inside the id",
      "id": "a:b",
      "type": "custom",
      "expect": "custom:a:b"
    },
    {
      "name": "only ASCII space, tab, newline, return, NUL and vertical tab are trimmed",
      "id": " u-829",
      "type": null,
      "expect": "custom: u-829"
    }
  ],
