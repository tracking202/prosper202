{
  "description": "Bodies of POST /api/v3/apps/installs and what the server makes of them (plan §5.2). A valid body's 'canonical' form — keys sorted at every level, no insignificant whitespace, integrity_token removed, slashes and non-ASCII unescaped — is what 'fingerprint' (lower-case hex SHA-256) is computed over: the server's replay check, and the requestHash input Play Integrity will use (PR 6). An invalid body is a 400 whose field_errors name exactly the listed fields. The app_key must also equal the registration's (a 422, not covered here: it needs a registration).",
  "cases": [
    {
      "name": "the reference install",
      "body": {
        "install_uuid": "8d7c4a52-9f0e-4b1d-a7c3-2e5f60718293",
        "app_key": "com.example.summit",
        "store": "google_play",
        "referrer": {
          "status": "ok",
          "install_referrer": "p202=42.3MVffxqa2WX3CV49&utm_source=newsletter",
          "referrer_click_timestamp_seconds": 1727200000,
          "install_begin_timestamp_seconds": 1727200042,
          "referrer_click_timestamp_server_seconds": 1727200001,
          "install_begin_timestamp_server_seconds": 1727200043,
          "install_version": "3.2.0",
          "google_play_instant": false
        },
        "first_open_at": 1727200100,
        "app_version": "3.2.0",
        "sdk_version": "1.0.0",
        "os_version": "15",
        "test": false,
        "integrity_token": null
      },
      "expect": {
        "valid": true,
        "canonical": "{\"app_key\":\"com.example.summit\",\"app_version\":\"3.2.0\",\"first_open_at\":1727200100,\"install_uuid\":\"8d7c4a52-9f0e-4b1d-a7c3-2e5f60718293\",\"os_version\":\"15\",\"referrer\":{\"google_play_instant\":false,\"install_begin_timestamp_seconds\":1727200042,\"install_begin_timestamp_server_seconds\":1727200043,\"install_referrer\":\"p202=42.3MVffxqa2WX3CV49&utm_source=newsletter\",\"install_version\":\"3.2.0\",\"referrer_click_timestamp_seconds\":1727200000,\"referrer_click_timestamp_server_seconds\":1727200001,\"status\":\"ok\"},\"sdk_version\":\"1.0.0\",\"store\":\"google_play\",\"test\":false}",
        "fingerprint": "24e659a4f8d70b46db15a679b91d44d5cb6d19e42fd3208568a96d0552dbd106"
      }
    },
