{
  "description": "What each store link, id or package names under AppIdentity (plan §4.2). Every client that accepts a store link sends it to the server, which reads it with this one parser; the PHP suite runs every vector, and SDK suites may read the same file. 'expect' is null when the value must be refused.",
  "store_links": [
    {"name": "App Store link", "input": "https://apps.apple.com/us/app/summit-run/id990077001", "expect": {"platform": "ios", "app_key": "990077001", "slug": "summit-run"}},
    {"name": "App Store link with a query", "input": "https://apps.apple.com/us/app/summit-run/id990077001?mt=8", "expect": {"platform": "ios", "app_key": "990077001", "slug": "summit-run"}},
    {"name": "App Store link, another region", "input": "https://apps.apple.com/gb/app/summit-run/id990077001", "expect": {"platform": "ios", "app_key": "990077001", "slug": "summit-run"}},
    {"name": "App Store link, no slug", "input": "https://apps.apple.com/app/id990077001", "expect": {"platform": "ios", "app_key": "990077001", "slug": ""}},
    {"name": "itunes.apple.com link", "input": "https://itunes.apple.com/us/app/summit-run/id990077001", "expect": {"platform": "ios", "app_key": "990077001", "slug": "summit-run"}},
    {"name": "App Store link without its scheme", "input": "apps.apple.com/us/app/summit-run/id990077001", "expect": {"platform": "ios", "app_key": "990077001", "slug": "summit-run"}},
    {"name": "bare App Store id", "input": "990077001", "expect": {"platform": "ios", "app_key": "990077001", "slug": ""}},
    {"name": "bare id with spaces", "input": "  990077001  ", "expect": {"platform": "ios", "app_key": "990077001", "slug": ""}},
    {"name": "the URL's last segment on its own", "input": "id990077001", "expect": {"platform": "ios", "app_key": "990077001", "slug": ""}},
    {"name": "last segment with spaces", "input": "  id990077001  ", "expect": {"platform": "ios", "app_key": "990077001", "slug": ""}},
    {"name": "Google Play link", "input": "https://play.google.com/store/apps/details?id=com.example.app", "expect": {"platform": "android", "app_key": "com.example.app", "slug": ""}},
    {"name": "Google Play link with more parameters", "input": "https://play.google.com/store/apps/details?id=com.example.app&hl=en_GB&gl=US", "expect": {"platform": "android", "app_key": "com.example.app", "slug": ""}},
    {"name": "Google Play link without its scheme", "input": "play.google.com/store/apps/details?id=com.example.app", "expect": {"platform": "android", "app_key": "com.example.app", "slug": ""}},
    {"name": "market link", "input": "market://details?id=com.example.app", "expect": {"platform": "android", "app_key": "com.example.app", "slug": ""}},
    {"name": "bare package", "input": "com.example.app", "expect": {"platform": "android", "app_key": "com.example.app", "slug": ""}},
    {"name": "package case is kept", "input": "com.Example.App_2", "expect": {"platform": "android", "app_key": "com.Example.App_2", "slug": ""}},
    {"name": "empty", "input": "", "expect": null},
    {"name": "blank", "input": "   ", "expect": null},
    {"name": "nonsense", "input": "not-an-app", "expect": null},
    {"name": "id inside a word is not an id", "input": "covid19", "expect": null},
    {"name": "negative", "input": "-5", "expect": null},
    {"name": "zero", "input": "0", "expect": null},
    {"name": "decimal", "input": "990077001.5", "expect": null},
    {"name": "id too big for an integer", "input": "99999999999999999999999", "expect": null},
    {"name": "store link whose id is too big", "input": "https://apps.apple.com/us/app/summit-run/id99999999999999999999999", "expect": null},
    {"name": "id-prefixed segment, too big", "input": "id99999999999999999999999", "expect": null},
    {"name": "a leading zero is not the same id", "input": "0990077001", "expect": null},
    {"name": "nor inside a link", "input": "https://apps.apple.com/us/app/x/id0990077001", "expect": null},
    {"name": "a link to another host", "input": "https://example.com/app/id123", "expect": null},
    {"name": "a lookalike host", "input": "https://apps.apple.com.evil.example/us/app/x/id990077001", "expect": null},
    {"name": "an App Store link naming no app", "input": "https://apps.apple.com/us/charts/iphone", "expect": null},
    {"name": "a Google Play link naming no app", "input": "https://play.google.com/store/apps/dev?id=123", "expect": null},
    {"name": "a Google Play link with no id", "input": "https://play.google.com/store/apps/details", "expect": null},
    {"name": "a Google Play link whose id is not a package", "input": "https://play.google.com/store/apps/details?id=example", "expect": null},
    {"name": "a Google Play link whose id is an array", "input": "https://play.google.com/store/apps/details?id[]=com.example.app", "expect": null},
    {"name": "a market link to something else", "input": "market://search?q=com.example.app", "expect": null},
    {"name": "a package segment starting with a digit", "input": "com.1example.app", "expect": null},
    {"name": "a single-segment package", "input": "example", "expect": null},
    {"name": "a package with a trailing dot", "input": "com.example.", "expect": null},
    {"name": "a package with a hyphen", "input": "com.my-app.android", "expect": null}
  ],
  "keys": [
    {"name": "an App Store id as digits", "platform": "ios", "app_key": "525463029", "expect": "525463029"},
    {"name": "an App Store id as a JSON number", "platform": "ios", "app_key": 525463029, "expect": "525463029"},
    {"name": "the platform inferred from digits", "platform": null, "app_key": "525463029", "expect_platform": "ios", "expect": "525463029"},
    {"name": "the platform inferred from a package", "platform": null, "app_key": "com.example.app", "expect_platform": "android", "expect": "com.example.app"},
    {"name": "the platform is a vocabulary word, not an identifier", "platform": " iOS ", "app_key": "525463029", "expect": "525463029"},
    {"name": "a float", "platform": "ios", "app_key": 1.5, "expect": null},
    {"name": "an exponent", "platform": "ios", "app_key": "1e2", "expect": null},
    {"name": "a leading space", "platform": "ios", "app_key": " 1", "expect": null},
    {"name": "a leading zero", "platform": "ios", "app_key": "0525463029", "expect": null},
    {"name": "zero", "platform": "ios", "app_key": 0, "expect": null},
    {"name": "negative", "platform": "ios", "app_key": -5, "expect": null},
    {"name": "saturating", "platform": "ios", "app_key": "99999999999999999999", "expect": null},
    {"name": "true", "platform": "ios", "app_key": true, "expect": null},
    {"name": "a package on ios", "platform": "ios", "app_key": "com.example.app", "expect": null},
    {"name": "digits on android", "platform": "android", "app_key": "525463029", "expect": null},
    {"name": "an unknown platform", "platform": "windows", "app_key": "525463029", "expect": null},
    {"name": "a platform that is not a string", "platform": ["ios"], "app_key": "525463029", "expect": null},
    {"name": "neither rule", "platform": null, "app_key": "not an app", "expect": null}
  ]
}
