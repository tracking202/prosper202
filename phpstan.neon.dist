# Committed PHPStan configuration.
#
# `phpstan.neon` stays gitignored for local overrides; this .dist file is what
# CI runs, so the repo's custom rules actually execute. PHPStan prefers
# phpstan.neon when present and falls back to this.
#
# customRulesetUsed disables PHPStan's built-in rule set on purpose. This job
# exists to enforce the "Error patterns to avoid" list in CLAUDE.md across a
# large legacy codebase, not to hold that codebase to a type-coverage level.
# Every rule below maps to a numbered pattern and has cost someone a real bug.
includes:
    - phpstan-baseline.neon

parameters:
    level: 0
    customRulesetUsed: true
    phpVersion: 80300
    bootstrapFiles:
        - phpstan-legacy-stubs.php
    paths:
        - api
        - 202-config
        - 202-account
        - 202-cronjobs
        - cli
        - tracking202
        # The public postback receivers. They are the only callers of
        # PostbackEndpoint::serve() that run outside the API router, so
        # without them a change to that signature (or to a protocol's
        # constructor) leaves the analysis green and the endpoints fatal on
        # the first device postback.
        - .well-known
    excludePaths:
        analyseAndScan:
            - vendor (?)
            - node_modules (?)

    # PHPStan's own default, restored. It governs the baseline as well as
    # ignoreErrors, so with it off the baseline could rot silently: an entry
    # whose findings were fixed (or whose file was deleted) stayed frozen at
    # its old count and nothing said so. On, the baseline can only shrink —
    # fixing a finding fails the build until the entry is updated to match.
    #
    # It is the machine check for a dead `@phpstan-ignore` comment too. The
    # nine this flag found on its first run all claimed to suppress something
    # this analysis does not produce, and had to be read one by one to
    # discover that; from here CI says so on the first push.
    #
    # Ignores that are conditional *by design* carry `reportUnmatched: false`
    # individually — see the block below for which, and why each one is.
    reportUnmatchedIgnoredErrors: true

    # Symbol resolution is not what this job checks. Large parts of the legacy
    # codebase are procedural includes with no autoloadable symbols, and the
    # analysis must not depend on which optional packages happen to be
    # installed — a missing dev dependency would otherwise bury the custom
    # rule findings this job exists to surface.
    #
    # Every entry here fires in some environments and not others, which is the
    # whole reason it exists, so each one sets `reportUnmatched: false`: being
    # unmatched is the *expected* state on a complete install, and the global
    # flag above would otherwise turn "your vendor/ is fine" into a build
    # failure. Measured on this tree at the time of writing — stashing a
    # single Composer package took class.notFound from 0 to 453,
    # method.notFound 0 to 136, staticMethod.notFound 0 to 5 and
    # class.noParent 0 to 1; includeOnce.fileNotFound's two findings are both
    # `202-config/connect.php`, which does not exist until an install
    # generates it; and function.notFound and include.fileNotFound resolve
    # only because the procedural file defining the symbol happens to be in
    # `paths` (verified by planting a call to a nonexistent function and a
    # bare `include` of a missing file — both are reported, so neither entry
    # is dead).
    #
    # This is NOT a place to park findings. An ignore that is unconditional
    # belongs in the baseline, where its count is tracked and has to shrink.
    ignoreErrors:
        # Three files declare a global `class INDEXES` with incompatible
        # signatures (202-config/class-indexes.php, functions-tracking202.php,
        # connect2.php). Each execution path loads exactly one and every call
        # site matches the copy its own path loads, but PHPStan cannot know
        # which — and which copy it picks varies by environment: locally it
        # resolves the static copy and reports arity errors, on CI it resolves
        # the instance-method copy and reports "static call to instance
        # method". Every call-site check against this class is therefore
        # unreliable, so ignore it by name rather than disabling whole
        # identifiers that catch real problems elsewhere. The duplicate
        # declarations themselves are tracked by DuplicateGlobalClassTest,
        # which is where that hazard belongs.
        -
            message: '#\bINDEXES::#'
            reportUnmatched: false
        -
            identifier: class.notFound
            reportUnmatched: false
        -
            identifier: class.noParent
            reportUnmatched: false
        -
            identifier: method.notFound
            reportUnmatched: false
        -
            identifier: staticMethod.notFound
            reportUnmatched: false
        -
            identifier: function.notFound
            reportUnmatched: false
        -
            identifier: includeOnce.fileNotFound
            reportUnmatched: false
        -
            identifier: include.fileNotFound
            reportUnmatched: false

rules:
    # CLAUDE.md #1 — unchecked return values after fallible calls.
    - Prosper202\PHPStan\Rules\ForbidDirectMysqliStmtCallRule
    # CLAUDE.md #4 — silent data loss on malformed input.
    - Prosper202\PHPStan\Rules\ForbidSilentJsonDecodeRule
    # CLAUDE.md #5 — inconsistent security patterns across similar operations.
    - Prosper202\PHPStan\Rules\ForbidDirectPasswordHashRule
    # CLAUDE.md #7 — bind_param type string mismatches.
    - Prosper202\PHPStan\Rules\BindParamArityRule
    # CLAUDE.md #8 — assumed closure, reference, and capture semantics.
    - Prosper202\PHPStan\Rules\ForbidArrowFnByRefCaptureRule
    # CLAUDE.md "Verify your assumptions" — a check that cannot fail is not a
    # check. `assertSame('verified-only', 'verified-only')` stood in for the
    # attribution report suite's only test of the verified-only default.
    #
    # The code this rule targets lives in tests/, which is deliberately NOT in
    # `paths` above and cannot be added here: analysing tests/ reports 14
    # pre-existing findings (8 from the other rules, 6 from PHPStan's own
    # level-0 checks) in files this change does not own, plus — whenever dev
    # dependencies are not installed — 84 non-ignorable "extends unknown class
    # PHPUnit\Framework\TestCase" errors, one per suite. So registration alone
    # would leave this rule looking at nothing.
    # tests/Api/V3/VacuousAssertionRuleTest.php runs THIS config over tests/
    # and fails on this identifier alone; that test is what gives the rule its
    # reach, and registering it here is what makes the test's run real.
    - Prosper202\PHPStan\Rules\VacuousAssertionRule
