# Keep secrets and local-only files out of the image build context. This
# matters for the final Dockerfile stage, which bakes the checkout into the
# image (Coolify / production deploys): anything not excluded here ships in
# every built image.

# Secrets and machine-local config — the container writes its own
# 202-config.php from environment variables at startup.
.env
.env.*
!.env.example
202-config.php
202-config*.php
!202-config-sample.php
build/staging-config.php

# VCS / CI / editor state
.git
.github
.claude
.DS_Store

# Dependencies are installed during the image build (composer) or not needed
# at runtime (node).
vendor
node_modules

# Local databases, build artifacts, and runtime state
mysql_data
mysql_data_staging
mysql_data_test_install
dist
build/debug
build/logs
docs
.ax-session
202-cronjobs/cron.lock
go-cli/prosper202-cli
go-cli/*.exe
