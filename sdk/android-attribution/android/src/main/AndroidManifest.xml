<?xml version="1.0" encoding="utf-8"?>
<!--
  The SDK needs the network and nothing else: no advertising ID, no AD_ID
  permission (plan §5.6). The install-referrer client adds its own
  BIND_GET_INSTALL_REFERRER_SERVICE permission through manifest merging.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
