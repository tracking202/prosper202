#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * p202 - the legacy PHP CLI for Prosper202 (Symfony Console)
 *
 * A local CLI tool for managing a remote Prosper202 installation: a subset
 * of the API, with `noun:verb` command names. The primary CLI, also invoked
 * as `p202`, is the Go one in go-cli/ (documentation/cli/10-go-cli.md); it
 * has the full command set. This entry point stays at bin/p202 because
 * scripts call it by that path.
 *
 * Quick start:
 *   p202 config:set-url https://your-prosper202.com
 *   p202 config:set-key your-api-key-here
 *   p202 campaign:list
 *
 * All commands support --json for machine-readable output.
 */

// Find autoloader
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../vendor/autoload.php',
    __DIR__ . '/../../../vendor/autoload.php',
];

$autoloaded = false;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        require_once $path;
        $autoloaded = true;
        break;
    }
}

if (!$autoloaded) {
    fwrite(STDERR, "Error: Could not find vendor/autoload.php. Run 'composer install' first.\n");
    exit(1);
}

$app = new P202Cli\Application();
$app->run();
